{
  "expo": {
    "name": "BuzzBee",
    "slug": "buzzbee-alarm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buzzbee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.cmtania.buzzbeealarm",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAlarmKitUsageDescription": "BuzzBee schedules your alarms with AlarmKit so they can still ring — and open BuzzBee straight to your mission — even if the app is fully closed."
      },
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.cmtania.buzzbeealarm"]
      }
    },
    "android": {
      "package": "com.cmtania.buzzbeealarm",
      "adaptiveIcon": {
        "backgroundColor": "#FBF3E4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "26.1"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF3E4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-background-task",
      [
        "expo-audio",
        {
          "microphonePermission": "BuzzBee listens for claps and buzzing sounds to dismiss the alarm, and can optionally sense room noise before ringing — that audio is analyzed on-device only and never recorded or uploaded. If you record your own alarm sound, that recording is saved only on your device and never uploaded.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-font",
      "expo-sqlite",
      [
        "expo-calendar",
        {
          "calendarPermission": "BuzzBee checks tomorrow's first calendar event so it can suggest shifting your wake window if there's a conflict."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#F5A623",
          "sounds": [
            "./assets/sounds/notif/classic_alarm.wav",
            "./assets/sounds/notif/digital_buzzer.wav",
            "./assets/sounds/notif/warning_buzzer.wav",
            "./assets/sounds/notif/morning_alarm.wav",
            "./assets/sounds/notif/intense_electricity.wav",
            "./assets/sounds/notif/sound_alert.wav",
            "./assets/sounds/notif/space_shooter.wav",
            "./assets/sounds/notif/vintage_telephone.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fcbffdc4-bd51-44cd-831f-9af2a9cb8ce4"
      }
    },
    "owner": "tania.dev.ph"
  }
}
